{
  "sdkVersion": "1.0",
  "id": "live.starlight",
  "name": "星瞳 Live",
  "version": "1.1.0",
  "author": "hy.禾一",
  "description": "自主开播、野生立绘捕捉、仿小红书热搜吃瓜社区与主播创作者中心。",
  "icon": "icon.png",
  "entry": "index.html",
  "permissions": [
    "app.data.read",
    "app.data.write",
    "characters.read",
    "characters.state.read",
    "characters.state.write",
    "user.profile.read",
    "ai.generate",
    "ai.generateImage",
    "ai.chat",
    "voice.tts",
    "voice.readProfiles",
    "wallet.read",
    "wallet.pay",
    "chat.sendCard",
    "chat.write",
    "chat.requestReply",
    "notifications.create",
    "ui.toast",
    "ui.notification"
  ],
  "resources": {
    "presets": ["presets.json"]
  },
  "extensions": {
    "chat": {
      "directives": [
        {
          "id": "live-share",
          "label": "分享直播间",
          "syntax": "[分享直播:主播名:直播标题:热度]",
          "description": "向好友分享正在进行的直播间卡片。"
        }
      ]
    }
  }
}
